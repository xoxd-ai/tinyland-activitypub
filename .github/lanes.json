{
  "schema_version": 3,
  "actions": {
    "unit-tests": {
      "command": "test",
      "targets": ["//:test", "//:package_artifact_test"],
      "capability": "rbe-linux-x86_64",
      "result": { "mode": "status-only" }
    },
    "package-check": {
      "command": "build",
      "targets": ["//:pkg"],
      "capability": "rbe-linux-x86_64",
      "result": { "mode": "status-only" }
    }
  }
}
