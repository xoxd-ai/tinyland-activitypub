"""
BUILD.bazel for @tummycrypt/tinyland-activitypub.

Dual-mode build: works with both pnpm (standalone) and Bazel (CI/production).
  Standalone: cd packages/tinyland-activitypub && pnpm build
"""

load("@aspect_rules_js//js:defs.bzl", "js_test")
load("@aspect_rules_js//npm:defs.bzl", "npm_link_package", "npm_package")
load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@tummycrypt_tinyland_activitypub_npm//:defs.bzl", "npm_link_all_packages")
load("@tummycrypt_tinyland_activitypub_npm//:vitest/package_json.bzl", vitest_bin = "bin")

npm_link_all_packages(name = "node_modules")

npm_link_package(
    name = "node_modules/@tummycrypt/tinyland-content-types",
    src = "@tummycrypt_tinyland_content_types//:pkg",
)


ts_project(
    name = "tinyland_activitypub",
    srcs = glob(
        ["src/**/*.ts"],
        exclude = [
            "src/**/*.test.ts",
            "src/**/*.spec.ts",
        ],
    ) + ["package.json"],
    declaration = True,
    declaration_map = True,
    source_map = False,
    tsconfig = ":tsconfig.json",
    transpiler = "tsc",
    out_dir = "dist",
    root_dir = "src",
    validate = False,
    deps = [
        ":node_modules",
        ":node_modules/@tummycrypt/tinyland-content-types",
        ":node_modules/@types/node",
        ":node_modules/gray-matter",
    ],
    visibility = ["//visibility:public"],
)

npm_package(
    name = "pkg",
    srcs = [
        "package.json",
        ":tinyland_activitypub",
    ],
    package = "@tummycrypt/tinyland-activitypub",
    version = "0.3.3",
    publishable = False,
    visibility = ["//visibility:public"],
)

# Validate the actual Bazel package directory with the locked third-party
# validator, without package-manager packing or provider publication.
js_test(
    name = "package_artifact_test",
    entry_point = "scripts/check-package-artifact.mjs",
    args = ["$(rootpath :pkg)"],
    data = [
        ":pkg",
        ":node_modules/publint",
        "package.json",
        "scripts/check-package-artifact.mjs",
    ],
    visibility = ["//visibility:public"],
)

vitest_bin.vitest_test(
    name = "test",
    data = [
        ".github/lanes.json",
        "BUILD.bazel",
        "MODULE.bazel",
        "docs/gf-v4-qualification.candidate.yml",
        "package.json",
        "scripts/check-package-artifact.mjs",
        ":node_modules",
        ":node_modules/@tummycrypt/tinyland-content-types",
        "tsconfig.json",
        ":node_modules/vitest",
        "vitest.config.ts",
    ] + glob(["src/**/*.ts"]) + glob(["tests/**/*.test.ts", "tests/**/*.ts"]) + glob(
        [
            ".github/workflows/*.yml",
            ".github/workflows/*.yaml",
        ],
        allow_empty = True,  # Legacy callers retired; the GF candidate remains inert.
    ),
    args = [
        "run",
        "--reporter=verbose",
        "--config",
        "$(rootpath vitest.config.ts)",
    ],
    log_level = "info",
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "package.json",
        "tsconfig.json",
        "vitest.config.ts",
    ],
    visibility = ["//visibility:public"],
)
